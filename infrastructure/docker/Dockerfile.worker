# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS base
WORKDIR /app
ENV npm_config_update_notifier=false \
    npm_config_fund=false

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg openssl ca-certificates gosu \
  && rm -rf /var/lib/apt/lists/*

FROM base AS deps
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
COPY packages/db/package.json ./packages/db/
COPY apps/worker/package.json ./apps/worker/
RUN --mount=type=cache,target=/root/.npm \
  npm ci --workspace=@bosla/worker --workspace=@bosla/shared --workspace=@bosla/config --workspace=@bosla/db --include-workspace-root

FROM deps AS build
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY packages/config ./packages/config
COPY packages/db ./packages/db
COPY apps/worker ./apps/worker

RUN npm run build --workspace=@bosla/shared \
  && npm run build --workspace=@bosla/config \
  && npm run build --workspace=@bosla/db \
  && npm run build --workspace=@bosla/worker

FROM base AS prod-deps
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
COPY packages/db/package.json ./packages/db/
COPY apps/worker/package.json ./apps/worker/
RUN --mount=type=cache,target=/root/.npm \
  npm ci --omit=dev --workspace=@bosla/worker --workspace=@bosla/shared --workspace=@bosla/config --workspace=@bosla/db --include-workspace-root
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma

FROM base AS runner
ENV NODE_ENV=production \
    WORKER_CONCURRENCY=1 \
    FFMPEG_THREADS=1 \
    NODE_OPTIONS="--max-old-space-size=256"
WORKDIR /app

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/config/package.json ./packages/config/package.json
COPY --from=build /app/packages/config/dist ./packages/config/dist
COPY --from=build /app/packages/db/package.json ./packages/db/package.json
COPY --from=build /app/packages/db/dist ./packages/db/dist
COPY --from=build /app/apps/worker/package.json ./apps/worker/package.json
COPY --from=build /app/apps/worker/dist ./apps/worker/dist
COPY infrastructure/docker/worker-entrypoint.sh /usr/local/bin/bosla-worker-entrypoint

RUN sed -i 's/\r$//' /usr/local/bin/bosla-worker-entrypoint \
  && chmod +x /usr/local/bin/bosla-worker-entrypoint \
  && mkdir -p /var/bosla/media/uploads-tmp /var/bosla/media/sources /var/bosla/media/hls /var/bosla/media/attachments /var/bosla/media/thumbnails \
  && chown -R node:node /app /var/bosla/media

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "const net=require('node:net');const u=new URL(process.env.REDIS_URL||'redis://redis:6379');const s=net.createConnection({host:u.hostname,port:Number(u.port||6379)},()=>{s.end();process.exit(0);});s.on('error',()=>process.exit(1));setTimeout(()=>process.exit(1),3000);"]

ENTRYPOINT ["/usr/local/bin/bosla-worker-entrypoint"]

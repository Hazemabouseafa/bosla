# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS base
WORKDIR /app
ENV npm_config_update_notifier=false \
    npm_config_fund=false

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates gosu \
  && rm -rf /var/lib/apt/lists/*

FROM base AS deps
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
COPY packages/db/package.json ./packages/db/
COPY apps/api/package.json ./apps/api/
RUN --mount=type=cache,target=/root/.npm \
  npm ci --workspace=@bosla/api --workspace=@bosla/shared --workspace=@bosla/config --workspace=@bosla/db --include-workspace-root

FROM deps AS build
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY packages/config ./packages/config
COPY packages/db ./packages/db
COPY apps/api ./apps/api

RUN npm run build --workspace=@bosla/shared \
  && npm run build --workspace=@bosla/config \
  && npm run build --workspace=@bosla/db \
  && npm run build --workspace=@bosla/api

FROM base AS prod-deps
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
COPY packages/db/package.json ./packages/db/
COPY apps/api/package.json ./apps/api/
RUN --mount=type=cache,target=/root/.npm \
  npm ci --omit=dev --workspace=@bosla/api --workspace=@bosla/shared --workspace=@bosla/config --workspace=@bosla/db --include-workspace-root
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma

FROM base AS runner
ENV NODE_ENV=production \
    PORT=4000 \
    NODE_OPTIONS="--max-old-space-size=384"
WORKDIR /app

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/config/package.json ./packages/config/package.json
COPY --from=build /app/packages/config/dist ./packages/config/dist
COPY --from=build /app/packages/db/package.json ./packages/db/package.json
COPY --from=build /app/packages/db/dist ./packages/db/dist
COPY --from=build /app/packages/db/prisma ./packages/db/prisma
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY infrastructure/docker/api-entrypoint.sh /usr/local/bin/bosla-api-entrypoint

RUN sed -i 's/\r$//' /usr/local/bin/bosla-api-entrypoint \
  && chmod +x /usr/local/bin/bosla-api-entrypoint \
  && mkdir -p /var/bosla/media/uploads-tmp /var/bosla/media/sources /var/bosla/media/hls /var/bosla/media/attachments /var/bosla/media/thumbnails \
  && chown -R node:node /app /var/bosla/media

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:4000/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

EXPOSE 4000
ENTRYPOINT ["/usr/local/bin/bosla-api-entrypoint"]

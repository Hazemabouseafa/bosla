FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

FROM base AS deps
COPY package.json package-lock.json* ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
COPY packages/db/package.json ./packages/db/
COPY packages/ui/package.json ./packages/ui/
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY apps/web/package.json ./apps/web/
RUN npm ci --workspace=@bosla/api --workspace=@bosla/shared --workspace=@bosla/config --workspace=@bosla/db --include-workspace-root

FROM deps AS build
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY packages/config ./packages/config
COPY packages/db ./packages/db
COPY apps/api ./apps/api
RUN npm run build --workspace=@bosla/shared && \
    npm run build --workspace=@bosla/config && \
    npm run build --workspace=@bosla/db && \
    npm run build --workspace=@bosla/api

FROM base AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/packages/shared ./packages/shared
COPY --from=build /app/packages/config ./packages/config
COPY --from=build /app/packages/db ./packages/db
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/package.json ./apps/api/package.json

RUN mkdir -p /var/bosla/media/uploads-tmp /var/bosla/media/sources /var/bosla/media/hls /var/bosla/media/attachments /var/bosla/media/thumbnails

EXPOSE 4000
CMD ["sh", "-c", "npx prisma migrate deploy --schema=packages/db/prisma/schema.prisma && node apps/api/dist/main.js"]

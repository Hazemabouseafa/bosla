    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.5.0",
    "@simplewebauthn/server": "^14.1.0",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.6",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",

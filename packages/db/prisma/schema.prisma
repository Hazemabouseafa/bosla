enum SellerApplicationStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum PayoutMethodType {
  BANK_TRANSFER
  INSTAPAY
  VODAFONE_CASH
  WALLET
}

enum DeliveryMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum AccountingClassification {
  COURSE_PURCHASE
  MONTHLY_MEMBERSHIP
  ANNUAL_MEMBERSHIP
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentChannel {
  PAYMOB_CARD
  PAYMOB_WALLET
  BANK_TRANSFER
  MANUAL_CASH
  OFFLINE_TRAINING
  INSTITUTIONAL
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

enum CommissionStatus {
  ON_HOLD
  ELIGIBLE
  APPROVED
  PAID
  DISPUTED
  REVERSED
}

enum RefundType {
  FULL
  PARTIAL
  CHARGEBACK
}

enum PayoutSettlementStatus {
  DRAFT
  APPROVED
  PAID
  FAILED
  CANCELLED
  CARRIED_FORWARD
}

enum InstructorApprovalStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  SUSPENDED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum OrganizationType {
  COMPANY
  UNIVERSITY
}

enum OrgMemberRole {
  ORG_ADMIN
  LEARNER
}

enum TrainingSessionType {
  ONLINE_LIVE
  OFFLINE_CLASS
  HYBRID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  WRITTEN
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  GRADED
  RESUBMIT_REQUESTED
}

enum SupportTicketCategory {
  TECHNICAL
  BILLING
  CONTENT
  CERTIFICATES
  OTHER
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

// ------------------------------------------------------------
// 7.1 FINE-GRAINED RBAC
// ------------------------------------------------------------

model RoleDefinition {
  id            String   @id @default(cuid())
  code          UserRole @unique
  nameAr        String
  descriptionAr String
  isSystem      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  permissions RolePermission[]
  assignments UserRoleAssignment[]
}

model PermissionDefinition {
  id            String   @id @default(cuid())
  code          String   @unique
  module        String
  nameAr        String
  descriptionAr String
  createdAt     DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       RoleDefinition       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PermissionDefinition @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRoleAssignment {
  id           String   @id @default(cuid())
  userId       String
  roleId       String
  assignedById String?
  createdAt    DateTime @default(now())

  user       User           @relation("AssignedUserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User?          @relation("GrantedUserRoles", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
}

// ------------------------------------------------------------
// 7.2 AFFILIATE / SELLER MANAGEMENT & REFERRALS
// ------------------------------------------------------------

model Seller {
  id                   String                  @id @default(cuid())
  userId               String                  @unique
  status               SellerApplicationStatus @default(PENDING)
  fullName             String
  phoneE164            String
  email                String?
  nationalIdNumber     String
  idDocumentUrl        String
  experienceSummaryAr  String
  marketingChannelsAr  String?
  payoutMethodType     PayoutMethodType
  payoutAccountName    String
  payoutAccountDetails String
  kycVerified          Boolean                 @default(false)
  payoutVerified       Boolean                 @default(false)
  verifiedById         String?
  verifiedAt           DateTime?
  suspensionReasonAr   String?
  minPayoutAmount      Decimal                 @default(500.00) @db.Decimal(12, 2)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  user             User                   @relation("SellerOwner", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy       User?                  @relation("SellerVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  applications     SellerApplication[]
  codes            SellerCode[]
  referrals        SellerReferral[]
  attributedOrders Order[]
  commissionRules  SellerCommissionRule[]
  commissions      SellerCommission[]
  payouts          SellerPayout[]
  reversalDebits   ReversalDebit[]
  adjustments      FinancialAdjustment[]

  @@index([status, createdAt])
  @@index([phoneE164])
  @@map("sellers")
}

model SellerApplication {
  id            String                  @id @default(cuid())
  sellerId      String
  userId        String
  submittedData Json
  status        SellerApplicationStatus @default(PENDING)
  reviewNotesAr String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  seller     Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user       User   @relation("SellerApplications", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("SellerApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@map("seller_applications")
}

model SellerCode {
  id               String   @id @default(cuid())
  sellerId         String
  code             String   @unique
  allowedCourseIds String[] @default([])
  isActive         Boolean  @default(true)
  usageCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  seller           Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  referrals        SellerReferral[]
  attributedOrders Order[]
  commissions      SellerCommission[]

  @@index([sellerId, isActive])
  @@map("seller_codes")
}

model SellerReferral {
  id              String   @id @default(cuid())
  trackingToken   String   @unique
  sellerId        String
  sellerCodeId    String
  normalizedCode  String
  userId          String?
  landingPath     String   @default("/")
  sourceTag       String?
  expiresAt       DateTime
  consumedOrderId String?
  createdAt       DateTime @default(now())

  seller     Seller     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerCode SellerCode @relation(fields: [sellerCodeId], references: [id], onDelete: Cascade)
  user       User?      @relation("TrackedReferralUser", fields: [userId], references: [id], onDelete: SetNull)
  orders     Order[]

  @@index([sellerId, createdAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("seller_referrals")
}

model MarketingMaterial {
  id            String   @id @default(cuid())
  titleAr       String
  descriptionAr String?
  assetType     String   @default("COPY")
  assetUrl      String?
  copyTextAr    String?
  courseId      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([isActive, createdAt])
}

// ------------------------------------------------------------
// 7.3 CART, COUPONS, ORDERS, PAYMENTS & ALLOCATIONS
// ------------------------------------------------------------

model CartItem {
  id       String   @id @default(cuid())
  userId   String
  courseId String
  addedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, addedAt])
}

model Coupon {
  id                 String             @id @default(cuid())
  code               String             @unique
  discountType       CouponDiscountType
  discountValue      Decimal            @db.Decimal(12, 2)
  maxDiscountAmount  Decimal?           @db.Decimal(12, 2)
  minOrderAmount     Decimal?           @db.Decimal(12, 2)
  applicableCourseId String?
  usageLimit         Int?
  usageCount         Int                @default(0)
  validFrom          DateTime           @default(now())
  validTo            DateTime?
  isActive           Boolean            @default(true)
  createdById        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  applicableCourse Course?             @relation(fields: [applicableCourseId], references: [id], onDelete: SetNull)
  createdBy        User?               @relation("CouponCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orders           Order[]
  campaigns        MarketingCampaign[]

  @@index([isActive, validFrom])
}

model Order {
  id                        String                   @id @default(cuid())
  orderNumber               String                   @unique
  userId                    String
  accountingType            AccountingClassification @default(COURSE_PURCHASE)
  membershipPlanId          String?
  organizationId            String?
  status                    OrderStatus              @default(PENDING_PAYMENT)
  subtotalAmount            Decimal                  @db.Decimal(12, 2)
  discountAmount            Decimal                  @default(0) @db.Decimal(12, 2)
  totalAmount               Decimal                  @db.Decimal(12, 2)
  paidAmount                Decimal                  @default(0) @db.Decimal(12, 2)
  refundedAmount            Decimal                  @default(0) @db.Decimal(12, 2)
  currency                  String                   @default("EGP")
  couponId                  String?
  couponCodeSnapshot        String?
  sellerId                  String?
  sellerCodeId              String?
  sellerCodeSnapshot        String?
  referralId                String?
  attributionOverriddenById String?
  attributionOverrideReason String?
  isFlaggedSuspicious       Boolean                  @default(false)
  suspiciousReason          String?
  deviceFingerprint         String?
  notesAr                   String?
  paidAt                    DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  user                    User                  @relation("OrderBuyer", fields: [userId], references: [id], onDelete: Restrict)
  membershipPlan          MembershipPlan?       @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)
  organization            Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  coupon                  Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  seller                  Seller?               @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  sellerCode              SellerCode?           @relation(fields: [sellerCodeId], references: [id], onDelete: SetNull)
  referral                SellerReferral?       @relation(fields: [referralId], references: [id], onDelete: SetNull)
  attributionOverriddenBy User?                 @relation("OrderAttributionOverrider", fields: [attributionOverriddenById], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  payments                OrderPayment[]
  allocations             PaymentAllocation[]
  commissions             SellerCommission[]
  refunds                 OrderRefund[]
  adjustments             FinancialAdjustment[]

  @@index([userId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([accountingType, createdAt])
  @@index([status, paidAt])
  @@map("orders")
}

model OrderItem {
  id                    String    @id @default(cuid())
  orderId               String
  courseId              String
  courseTitleSnapshotAr String
  unitPrice             Decimal   @db.Decimal(12, 2)
  discountAmount        Decimal   @default(0) @db.Decimal(12, 2)
  finalPrice            Decimal   @db.Decimal(12, 2)
  allocatedPaidAmount   Decimal   @default(0) @db.Decimal(12, 2)
  refundedAmount        Decimal   @default(0) @db.Decimal(12, 2)
  sortOrder             Int       @default(0)
  entitlementGrantedAt  DateTime?
  entitlementRevokedAt  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course      Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]
  commission  SellerCommission?
  refunds     OrderRefund[]

  @@unique([orderId, courseId])
  @@index([courseId, createdAt])
  @@map("order_items")
}

model OrderPayment {
  id               String         @id @default(cuid())
  orderId          String
  paymentMethod    PaymentChannel
  status           PaymentStatus  @default(PENDING)
  amount           Decimal        @db.Decimal(12, 2)
  allocatedAmount  Decimal        @default(0) @db.Decimal(12, 2)
  externalTxId     String?        @unique
  receiptReference String?
  bankName         String?
  proofUrl         String?
  recordedById     String?
  notesAr          String?
  paidAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedBy  User?               @relation("OrderPaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]
  refunds     OrderRefund[]

  @@index([orderId, status, createdAt])
  @@map("payments")
}

model PaymentAllocation {
  id               String   @id @default(cuid())
  paymentId        String
  orderId          String
  orderItemId      String
  allocatedAmount  Decimal  @db.Decimal(12, 2)
  isManualOverride Boolean  @default(false)
  overriddenById   String?
  overrideReason   String?
  createdAt        DateTime @default(now())

  payment      OrderPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  overriddenBy User?        @relation("AllocationOverrider", fields: [overriddenById], references: [id], onDelete: SetNull)

  @@unique([paymentId, orderItemId])
  @@index([orderId, createdAt])
  @@index([orderItemId])
  @@map("payment_allocations")
}

// ------------------------------------------------------------
// 7.4 SELLER COMMISSION ENGINE, REFUNDS, SETTLEMENTS & RECONCILIATION
// ------------------------------------------------------------

model SellerCommissionRule {
  id            String    @id @default(cuid())
  courseId      String
  sellerId      String?
  fixedAmount   Decimal   @db.Decimal(12, 2)
  capPercent    Decimal   @default(50.00) @db.Decimal(5, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  seller      Seller?            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("CommissionRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  commissions SellerCommission[]

  @@index([courseId, sellerId, isActive, effectiveFrom])
  @@map("seller_commission_rules")
}

model SellerCommission {
  id                     String           @id @default(cuid())
  sellerId               String
  sellerCodeId           String?
  orderId                String
  orderItemId            String           @unique
  courseId               String
  ruleId                 String?
  itemNetPrice           Decimal          @db.Decimal(12, 2)
  allocatedPaidAmount    Decimal          @db.Decimal(12, 2)
  configuredAmount       Decimal          @db.Decimal(12, 2)
  capPercent             Decimal          @db.Decimal(5, 2)
  cappedAmount           Decimal          @db.Decimal(12, 2)
  appliedAmount          Decimal          @db.Decimal(12, 2)
  reversedAmount         Decimal          @default(0) @db.Decimal(12, 2)
  netAmount              Decimal          @db.Decimal(12, 2)
  status                 CommissionStatus @default(ON_HOLD)
  holdStartsAt           DateTime
  eligibleAt             DateTime
  approvedAt             DateTime?
  approvedById           String?
  paidAt                 DateTime?
  disputedReason         String?
  warningNote            String?
  failedPayoutRetryCount Int              @default(0)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  seller        Seller                    @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sellerCode    SellerCode?               @relation(fields: [sellerCodeId], references: [id], onDelete: SetNull)
  order         Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem     OrderItem                 @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  course        Course                    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  rule          SellerCommissionRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  approvedBy    User?                     @relation("CommissionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  history       CommissionStatusHistory[]
  payoutItems   SellerPayoutItem[]
  reversalDebit ReversalDebit[]
  adjustments   FinancialAdjustment[]

  @@index([sellerId, status, eligibleAt])
  @@index([status, eligibleAt])
  @@index([orderId])
  @@map("seller_commissions")
}

model CommissionStatusHistory {
  id           String            @id @default(cuid())
  commissionId String
  fromStatus   CommissionStatus?
  toStatus     CommissionStatus
  changedById  String?
  reasonAr     String?
  metadata     Json?
  createdAt    DateTime          @default(now())

  commission SellerCommission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  changedBy  User?            @relation("CommissionHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([commissionId, createdAt])
  @@map("commission_status_history")
}

model OrderRefund {
  id                       String     @id @default(cuid())
  orderId                  String
  orderItemId              String?
  paymentId                String?
  refundType               RefundType
  refundAmount             Decimal    @db.Decimal(12, 2)
  commissionReversedAmount Decimal    @default(0) @db.Decimal(12, 2)
  revokeAccess             Boolean    @default(false)
  reasonAr                 String
  processedById            String
  createdAt                DateTime   @default(now())

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem      OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  payment        OrderPayment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  processedBy    User            @relation("RefundProcessor", fields: [processedById], references: [id], onDelete: Restrict)
  reversalDebits ReversalDebit[]

  @@index([orderId, createdAt])
  @@map("refunds")
}

model ReversalDebit {
  id              String   @id @default(cuid())
  sellerId        String
  commissionId    String
  refundId        String?
  originalAmount  Decimal  @db.Decimal(12, 2)
  settledAmount   Decimal  @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal  @db.Decimal(12, 2)
  reasonAr        String
  settledPayoutId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seller        Seller           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  commission    SellerCommission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  refund        OrderRefund?     @relation(fields: [refundId], references: [id], onDelete: SetNull)
  settledPayout SellerPayout?    @relation(fields: [settledPayoutId], references: [id], onDelete: SetNull)

  @@index([sellerId, remainingAmount])
}

model SellerPayout {
  id                    String                 @id @default(cuid())
  settlementNumber      String                 @unique
  sellerId              String
  periodYear            Int
  periodMonth           Int
  periodStartUtc        DateTime
  periodEndUtc          DateTime
  grossCommissionAmount Decimal                @db.Decimal(12, 2)
  reversalDebitDeducted Decimal                @default(0) @db.Decimal(12, 2)
  adjustmentAmount      Decimal                @default(0) @db.Decimal(12, 2)
  netPayableAmount      Decimal                @db.Decimal(12, 2)
  carriedForwardAmount  Decimal                @default(0) @db.Decimal(12, 2)
  status                PayoutSettlementStatus @default(DRAFT)
  createdById           String
  approvedById          String?
  approvedAt            DateTime?
  paidById              String?
  paidAt                DateTime?
  transferReference     String?
  paymentProofUrl       String?
  failureReasonAr       String?
  notesAr               String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  seller         Seller                @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  createdBy      User                  @relation("PayoutCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy     User?                 @relation("PayoutApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  paidBy         User?                 @relation("PayoutExecutor", fields: [paidById], references: [id], onDelete: SetNull)
  items          SellerPayoutItem[]
  settledDebits  ReversalDebit[]
  adjustments    FinancialAdjustment[]

  @@index([sellerId, periodYear, periodMonth])
  @@index([status, createdAt])
  @@map("seller_payouts")
}

model SellerPayoutItem {
  id           String   @id @default(cuid())
  payoutId     String
  commissionId String
  amount       Decimal  @db.Decimal(12, 2)
  isVoided     Boolean  @default(false)
  createdAt    DateTime @default(now())

  payout     SellerPayout     @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  commission SellerCommission @relation(fields: [commissionId], references: [id], onDelete: Restrict)

  @@index([payoutId])
  @@index([commissionId, isVoided])
  @@map("seller_payout_items")
}

model FinancialAdjustment {
  id           String   @id @default(cuid())
  sellerId     String
  payoutId     String?
  commissionId String?
  orderId      String?
  amount       Decimal  @db.Decimal(12, 2)
  reasonAr     String
  createdById  String
  createdAt    DateTime @default(now())

  seller     Seller            @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  payout     SellerPayout?     @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  commission SellerCommission? @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  order      Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy  User              @relation("FinancialAdjustmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([sellerId, createdAt])
  @@map("financial_adjustments")
}

model FinancialExpense {
  id            String   @id @default(cuid())
  categoryAr    String
  courseId      String?
  descriptionAr String
  amount        Decimal  @db.Decimal(12, 2)
  incurredAt    DateTime
  receiptRef    String?
  recordedById  String
  createdAt     DateTime @default(now())

  course     Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  recordedBy User    @relation("ExpenseRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([incurredAt])
  @@index([courseId])
}

model AccountingPeriodClose {
  id                    String   @id @default(cuid())
  periodYear            Int
  periodMonth           Int
  periodStartUtc        DateTime
  periodEndUtc          DateTime
  recognizedRevenue     Decimal  @db.Decimal(12, 2)
  cashCollected         Decimal  @db.Decimal(12, 2)
  totalRefunds          Decimal  @db.Decimal(12, 2)
  totalCommissions      Decimal  @db.Decimal(12, 2)
  totalInstructorShares Decimal  @db.Decimal(12, 2)
  totalExpenses         Decimal  @db.Decimal(12, 2)
  netProfit             Decimal  @db.Decimal(12, 2)
  isClosed              Boolean  @default(true)
  closedById            String
  closedAt              DateTime @default(now())
  notesAr               String?

  closedBy User @relation("PeriodCloser", fields: [closedById], references: [id], onDelete: Restrict)

  @@unique([periodYear, periodMonth])
}

// ------------------------------------------------------------
// 7.5 INSTRUCTOR PROFILE & CONTRACT EXTENSIONS
// ------------------------------------------------------------

model InstructorProfile {
  id              String                   @id @default(cuid())
  userId          String                   @unique
  specializations String[]                 @default([])
  yearsExperience Int                      @default(0)
  cvUrl           String?
  approvalStatus  InstructorApprovalStatus @default(APPROVED)
  reviewNotesAr   String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  user       User  @relation("InstructorProfileOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("InstructorProfileReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}

model InstructorContract {
  id                     String   @id @default(cuid())
  instructorId           String
  titleAr                String
  startDate              DateTime
  endDate                DateTime
  defaultSharePercent    Decimal  @db.Decimal(5, 2)
  deductSellerCommission Boolean  @default(false)
  documentUrl            String?
  isActive               Boolean  @default(true)
  createdById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  instructor User  @relation("InstructorContractOwner", fields: [instructorId], references: [id], onDelete: Cascade)
  createdBy  User? @relation("InstructorContractCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([instructorId, isActive, endDate])

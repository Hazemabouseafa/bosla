model CourseWaitlist {
  id         String    @id @default(cuid())
  courseId   String
  userId     String
  position   Int
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation("CourseWaitlistUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId, position])
}

model TrainingSession {
  id               String              @id @default(cuid())
  courseId         String
  cohortId         String?
  instructorId     String?
  titleAr          String
  sessionType      TrainingSessionType @default(ONLINE_LIVE)
  startsAt         DateTime
  endsAt           DateTime
  venueAr          String?
  manualMeetingUrl String?
  recordingUrl     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cohort     TrainingCohort?    @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  instructor User?              @relation("SessionInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  attendance AttendanceRecord[]

  @@index([courseId, startsAt])
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  sessionId  String
  userId     String
  status     AttendanceStatus @default(PRESENT)
  notesAr    String?
  markedById String?
  markedAt   DateTime         @default(now())

  session  TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user     User            @relation("StudentAttendance", fields: [userId], references: [id], onDelete: Cascade)
  markedBy User?           @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@index([userId])
}

model QuestionBankCategory {
  id            String   @id @default(cuid())
  nameAr        String   @unique
  descriptionAr String?
  createdAt     DateTime @default(now())

  items QuestionBankItem[]
}

model QuestionBankItem {
  id            String       @id @default(cuid())
  categoryId    String?
  courseId      String?
  questionType  QuestionType @default(MCQ)
  promptAr      String
  options       Json?
  correctAnswer String?
  explanationAr String?
  defaultPoints Int          @default(1)
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  category      QuestionBankCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  course        Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy     User?                 @relation("QuestionBankCreator", fields: [createdById], references: [id], onDelete: SetNull)
  quizQuestions QuizQuestion[]

  @@index([courseId, questionType])
}

model Assignment {
  id                 String    @id @default(cuid())
  courseId           String
  lessonId           String?
  titleAr            String
  instructionsAr     String
  maxScore           Int       @default(100)
  passingScore       Int       @default(60)
  dueAt              DateTime?
  isPracticalProject Boolean   @default(false)
  rubric             Json?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson?                @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy   User?                  @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]

  @@index([courseId, createdAt])
}

model AssignmentSubmission {
  id               String                     @id @default(cuid())
  assignmentId     String
  userId           String
  submissionTextAr String
  attachmentUrl    String?
  status           AssignmentSubmissionStatus @default(SUBMITTED)
  score            Int?
  rubricScores     Json?
  feedbackAr       String?
  gradedById       String?
  gradedAt         DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation("StudentAssignments", fields: [userId], references: [id], onDelete: Cascade)
  gradedBy   User?      @relation("AssignmentGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, userId])
  @@index([status, createdAt])
}


model CrmPipelineStage {
  id        String   @id @default(cuid())
  key       String   @unique
  nameAr    String
  sortOrder Int      @default(0)
  colorHex  String   @default("#6C4DF6")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MarketingCampaign {
  id           String    @id @default(cuid())
  nameAr       String
  channel      String
  budgetAmount Decimal   @default(0) @db.Decimal(12, 2)
  spendAmount  Decimal   @default(0) @db.Decimal(12, 2)
  couponId     String?
  startDate    DateTime

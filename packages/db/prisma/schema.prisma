model CmsPage {
  id               String   @id @default(cuid())
  slug             String   @unique
  titleAr          String
  seoTitleAr       String?
  seoDescriptionAr String?
  sections         Json
  isPublished      Boolean  @default(true)
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model CmsTestimonial {
  id            String   @id @default(cuid())
  studentNameAr String
  roleTitleAr   String
  companyAr     String?
  quoteAr       String
  rating        Int      @default(5)
  isPublished   Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
}

model CmsPartner {
  id            String   @id @default(cuid())
  nameAr        String
  logoUrl       String?
  websiteUrl    String?
  descriptionAr String?
  isPublished   Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
}

model CmsFaq {
  id          String   @id @default(cuid())
  questionAr  String
  answerAr    String
  categoryAr  String   @default("عام")
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model SiteSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model SpecializationDomain {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameAr        String
  descriptionAr String
  weightsCode   String
  speciesCode   String   @default("")
  sortOrder     Int      @default(0)

  subfields SpecializationSubfield[]
}

model SpecializationSubfield {
  id            String @id @default(cuid())
  domainId      String
  nameAr        String
  descriptionAr String
  sortOrder     Int    @default(0)

  domain SpecializationDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  leaves SpecializationLeaf[]
}

model SpecializationLeaf {
  id               String  @id @default(cuid())
  subfieldId       String
  nameAr           String
  mappedCourseId   String?
  sortOrder        Int     @default(0)

  subfield     SpecializationSubfield @relation(fields: [subfieldId], references: [id], onDelete: Cascade)
  mappedCourse Course?                @relation(fields: [mappedCourseId], references: [id], onDelete: SetNull)
}

model SpecializationQuestion {
  id         String @id @default(cuid())
  promptAr   String
  options    Json
  sortOrder  Int    @default(0)
}

model LeadSubmission {
  id                 String       @id @default(cuid())
  type               LeadType
  fullName           String
  companyName        String?
  phoneE164          String
  email              String?
  roleLabel          String?
  interest           String?
  interestedCourseId String?
  sector             String?
  teamSize           String?
  need               String?
  timeline           String?
  leadScore          Int?
  priority           LeadPriority @default(MEDIUM)
  pipelineStageKey   String       @default("NEW")
  assignedToId       String?
  campaignId         String?
  consentMarketing   Boolean      @default(false)
  notes              String?
  status             LeadStatus   @default(NEW)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  interestedCourse Course?            @relation(fields: [interestedCourseId], references: [id], onDelete: SetNull)
  assignedTo       User?              @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  campaign         MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  activities       LeadActivity[]

  @@index([type, status, createdAt])
  @@index([pipelineStageKey, createdAt])
  @@index([phoneE164])
}

// ============================================================
// 8. COURSE COMMUNITY, LESSON Q&A, MODERATION & NOTIFICATIONS
// ============================================================

model CourseEnrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  source    String   @default("PLAYER")
  startedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, startedAt])
}

model CourseCommunitySettings {
  id                      String   @id @default(cuid())
  courseId                String   @unique
  isEnabled               Boolean  @default(true)
  adminDisabled           Boolean  @default(false)
  allowStudentDiscussions Boolean  @default(true)
  updatedById             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  updatedBy User?  @relation("CommunitySettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model CommunityPost {
  id                    String              @id @default(cuid())
  courseId              String
  lessonId              String?
  lessonStableKey       String?
  lessonTitleSnapshot   String?
  authorId              String
  type                  CommunityPostType   @default(QUESTION)
  title                 String
  body                  String
  videoTimestampSeconds Int?
  status                CommunityPostStatus @default(ACTIVE)
  isPinned              Boolean             @default(false)
  isLocked              Boolean             @default(false)
  isAnswered            Boolean             @default(false)
  acceptedCommentId     String?             @unique
  firstInstructorReplyAt DateTime?
  likeCount             Int                 @default(0)
  commentCount          Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  course          Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson          Lesson?                  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  author          User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  acceptedComment CommunityComment?        @relation("AcceptedPostAnswer", fields: [acceptedCommentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  comments        CommunityComment[]       @relation("PostComments")
  reactions       CommunityReaction[]
  reports         CommunityReport[]
  moderationLogs  CommunityModerationLog[]

  @@index([courseId, deletedAt, status, isPinned, createdAt])
  @@index([courseId, lessonId, deletedAt, createdAt])
  @@index([courseId, lessonStableKey, deletedAt, createdAt])
  @@index([courseId, type, isAnswered, deletedAt])
  @@index([authorId, createdAt])
}

model CommunityComment {
  id              String    @id @default(cuid())
  postId          String
  parentCommentId String?
  authorId        String
  body            String
  likeCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  post           CommunityPost            @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)
  parentComment  CommunityComment?        @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies        CommunityComment[]       @relation("CommentReplies")
  author         User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  acceptedFor    CommunityPost?           @relation("AcceptedPostAnswer")
  reactions      CommunityReaction[]
  reports        CommunityReport[]
  moderationLogs CommunityModerationLog[]

  @@index([postId, deletedAt, createdAt])
  @@index([parentCommentId])
  @@index([authorId])
}

model CommunityReaction {
  id         String                @id @default(cuid())
  userId     String
  targetType CommunityTargetType
  postId     String?
  commentId  String?
  type       CommunityReactionType @default(LIKE)
  createdAt  DateTime              @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, type])
  @@unique([userId, commentId, type])
  @@index([postId])
  @@index([commentId])
}

model CommunityReport {
  id              String                @id @default(cuid())
  reporterId      String
  courseId        String
  targetType      CommunityTargetType
  postId          String?
  commentId       String?
  reason          String
  details         String?
  status          CommunityReportStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime              @default(now())

  reporter   User              @relation("CommunityReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User?             @relation("CommunityReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  course     Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  post       CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@index([status, createdAt])
  @@index([courseId, status])
}

model CommunityModerationLog {
  id        String   @id @default(cuid())
  courseId  String
  postId    String?
  commentId String?
  actorId   String
  actorRole UserRole
  action    String
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())

  course  Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  post    CommunityPost?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment CommunityComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  actor   User              @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([actorId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  titleAr   String
  bodyAr    String
  actionUrl String
  dedupKey  String?
  courseId  String?
  postId    String?
  commentId String?
  lessonId  String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupKey])
  @@index([userId, isRead, createdAt])
}

model NotificationPreference {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  notifyOnInstructorReply    Boolean  @default(true)
  notifyOnDiscussionReply    Boolean  @default(true)
  notifyOnAcceptedAnswer     Boolean  @default(true)
  notifyOnNewStudentQuestion Boolean @default(true)
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// 9. MULTI-INSTRUCTOR PROGRAMS, FINANCIAL ACCOUNTS, STATEMENTS,
//    DIRECT PURCHASES, COMPETENCY CERTIFICATES & SUBSCRIBER Q&A
// ============================================================

model DirectPurchase {
  id                   String                @id @default(cuid())
  userId               String
  targetType           CertificateTargetType @default(COURSE)
  courseId             String?
  learningPathId       String?
  diplomaId            String?
  amountCents          Int
  currency             String                @default("EGP")
  status               SubscriptionStatus    @default(ACTIVE)
  paymentTransactionId String?               @unique
  purchasedAt          DateTime              @default(now())
  revokedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course             Course?             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learningPath       LearningPath?       @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  diploma            Diploma?            @relation(fields: [diplomaId], references: [id], onDelete: Cascade)
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([courseId, status])
  @@index([learningPathId, status])
  @@index([diplomaId, status])
}

model ProgramInstructorAssignment {
  id                  String                @id @default(cuid())
  instructorId        String
  targetType          CertificateTargetType @default(COURSE)
  courseId            String?
  learningPathId      String?
  diplomaId           String?
  roleTitleAr         String                @default("مدرب مشارك")
  revenueSharePercent Float                 @default(0)
  isPrimary           Boolean               @default(false)
  assignedById        String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  instructor   User          @relation("ProgramAssignedInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  assignedBy   User?         @relation("ProgramInstructorAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learningPath LearningPath? @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  diploma      Diploma?      @relation(fields: [diplomaId], references: [id], onDelete: Cascade)

  @@index([instructorId, targetType])
  @@index([courseId])
  @@index([learningPathId])
  @@index([diplomaId])
}

model ProgramFinancialAccount {
  id                        String                @id @default(cuid())
  accountCode               String                @unique
  targetType                CertificateTargetType @default(COURSE)
  courseId                  String?               @unique
  learningPathId            String?               @unique
  diplomaId                 String?               @unique
  totalGrossRevenueCents    Int                   @default(0)
  totalInstructorShareCents Int                   @default(0)
  totalPlatformShareCents   Int                   @default(0)
  totalRefundedCents        Int                   @default(0)
  netBalanceCents           Int                   @default(0)
  currency                  String                @default("EGP")
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  course       Course?              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learningPath LearningPath?        @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  diploma      Diploma?             @relation(fields: [diplomaId], references: [id], onDelete: Cascade)
  entries      ProgramLedgerEntry[]
}

model ProgramLedgerEntry {
  id                   String                   @id @default(cuid())
  accountId            String
  type                 FinancialLedgerEntryType
  amountCents          Int
  instructorShareCents Int                      @default(0)
  platformShareCents   Int                      @default(0)
  balanceAfterCents    Int                      @default(0)
  descriptionAr        String
  paymentRecordId      String?
  createdById          String?
  createdAt            DateTime                 @default(now())

  account       ProgramFinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  paymentRecord FinancialPaymentRecord? @relation(fields: [paymentRecordId], references: [id], onDelete: SetNull)
  createdBy     User?                   @relation("ProgramLedgerCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
}

model InstructorFinancialAccount {
  id                  String                     @id @default(cuid())
  accountCode         String                     @unique
  instructorId        String                     @unique
  totalEarnedCents    Int                        @default(0)
  totalPaidOutCents   Int                        @default(0)
  pendingBalanceCents Int                        @default(0)
  currency            String                     @default("EGP")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  instructor User                       @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  entries    InstructorStatementEntry[]
}

model InstructorStatementEntry {
  id                   String                   @id @default(cuid())
  accountId            String
  instructorId         String
  type                 FinancialLedgerEntryType
  targetType           CertificateTargetType?
  courseId             String?
  learningPathId       String?
  diplomaId            String?
  programTitleSnapshot String?
  grossAmountCents     Int                      @default(0)
  sharePercent         Float                    @default(0)
  netAmountCents       Int
  balanceAfterCents    Int                      @default(0)
  descriptionAr        String
  paymentRecordId      String?
  createdById          String?
  createdAt            DateTime                 @default(now())

  account       InstructorFinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instructor    User                       @relation("InstructorStatementOwner", fields: [instructorId], references: [id], onDelete: Cascade)
  paymentRecord FinancialPaymentRecord?    @relation(fields: [paymentRecordId], references: [id], onDelete: SetNull)
  createdBy     User?                      @relation("InstructorStatementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([instructorId, createdAt])
}

model FinancialPaymentRecord {
  id                   String                 @id @default(cuid())
  referenceCode        String                 @unique
  direction            String                 @default("INBOUND")
  targetType           CertificateTargetType?
  courseId             String?
  learningPathId       String?
  diplomaId            String?
  programTitleSnapshot String?
  payerUserId          String?
  payeeInstructorId    String?
  paymentTransactionId String?                @unique
  grossAmountCents     Int
  instructorShareCents Int                    @default(0)
  platformShareCents   Int                    @default(0)
  currency             String                 @default("EGP")
  paymentMethodAr      String                 @default("الدفع الإلكتروني")
  status               PaymentStatus          @default(PAID)
  notesAr              String?
  recordedById         String?
  createdAt            DateTime               @default(now())

  payer              User?                      @relation("FinancialRecordPayer", fields: [payerUserId], references: [id], onDelete: SetNull)
  payeeInstructor    User?                      @relation("FinancialRecordPayee", fields: [payeeInstructorId], references: [id], onDelete: SetNull)
  recordedBy         User?                      @relation("FinancialRecordRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  paymentTransaction PaymentTransaction?        @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  programEntries     ProgramLedgerEntry[]
  instructorEntries  InstructorStatementEntry[]

  @@index([createdAt])
  @@index([payeeInstructorId, createdAt])
  @@index([payerUserId, createdAt])
}

model CompetencyCertificateRequest {
  id             String                  @id @default(cuid())
  userId         String
  targetType     CertificateTargetType   @default(COURSE)
  courseId       String?
  learningPathId String?
  diplomaId      String?
  status         CompetencyRequestStatus @default(PENDING)
  studentNotesAr String?
  evidenceUrl    String?
  reviewedById   String?
  reviewedByRole UserRole?
  reviewedAt     DateTime?
  reviewNotesAr  String?
  certificateId  String?                 @unique
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  user         User          @relation("StudentCompetencyRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?         @relation("ReviewerCompetencyRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learningPath LearningPath? @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  diploma      Diploma?      @relation(fields: [diplomaId], references: [id], onDelete: Cascade)
  certificate  Certificate?  @relation(fields: [certificateId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([courseId, status])
  @@index([status, createdAt])
}

model SubscriberQuestion {
  id               String    @id @default(cuid())
  authorId         String
  topicAr          String    @default("عام")
  titleAr          String
  bodyAr           String
  courseId         String?
  upvoteCount      Int       @default(0)
  answerCount      Int       @default(0)
  isResolved       Boolean   @default(false)
  acceptedAnswerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  author         User               @relation("SubscriberQuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  course         Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  acceptedAnswer SubscriberAnswer?  @relation("AcceptedSubscriberAnswer", fields: [acceptedAnswerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  answers        SubscriberAnswer[] @relation("QuestionAnswers")
  votes          SubscriberVote[]

  @@index([deletedAt, createdAt])
  @@index([topicAr, deletedAt, createdAt])
  @@index([authorId, createdAt])
}

model SubscriberAnswer {
  id          String    @id @default(cuid())
  questionId  String
  authorId    String
  bodyAr      String
  upvoteCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  question    SubscriberQuestion  @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Cascade)
  author      User                @relation("SubscriberAnswerAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  acceptedFor SubscriberQuestion? @relation("AcceptedSubscriberAnswer")
  votes       SubscriberVote[]

  @@index([questionId, deletedAt, upvoteCount, createdAt])
  @@index([authorId])
}

model SubscriberVote {
  id         String   @id @default(cuid())
  userId     String
  questionId String?
  answerId   String?
  createdAt  DateTime @default(now())

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  question SubscriberQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer   SubscriberAnswer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@unique([userId, answerId])
}



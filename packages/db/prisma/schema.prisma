// ------------------------------------------------------------
// 7.7 B2B ORGANIZATIONS, COHORTS & CONTRACTS
// ------------------------------------------------------------

model Organization {
  id           String           @id @default(cuid())
  nameAr       String
  type         OrganizationType @default(COMPANY)
  taxNumber    String?
  contactNameAr String
  contactPhone String
  contactEmail String?
  seatCapacity Int              @default(20)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  members   OrganizationMember[]
  cohorts   TrainingCohort[]
  contracts OrganizationContract[]
  orders    Order[]

  @@index([isActive, createdAt])
}

model OrganizationMember {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  orgRole        OrgMemberRole @default(LEARNER)
  departmentAr   String?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model TrainingCohort {
  id             String   @id @default(cuid())
  courseId       String
  organizationId String?
  titleAr        String
  startsAt       DateTime
  endsAt         DateTime
  maxSeats       Int      @default(30)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course       Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  enrollments  CohortEnrollment[]
  sessions     TrainingSession[]

  @@index([courseId, startsAt])
  @@index([organizationId])
}

model CohortEnrollment {
  id           String   @id @default(cuid())
  cohortId     String
  userId       String
  enrolledById String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  cohort     TrainingCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user       User           @relation("CohortStudent", fields: [userId], references: [id], onDelete: Cascade)
  enrolledBy User?          @relation("CohortEnroller", fields: [enrolledById], references: [id], onDelete: SetNull)

  @@unique([cohortId, userId])
}

model OrganizationContract {
  id                String    @id @default(cuid())
  organizationId    String
  contractNumber    String    @unique
  titleAr           String
  quotationAmount   Decimal   @db.Decimal(12, 2)
  discountPercent   Decimal   @default(0) @db.Decimal(5, 2)
  validFrom         DateTime
  validTo           DateTime?
  assignedCourseIds String[]  @default([])
  status            String    @default("ACTIVE")
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("OrgContractCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

// ------------------------------------------------------------
// 7.8 ADVANCED LMS: WAITLIST, SESSIONS, ATTENDANCE, QUESTION BANK, ASSIGNMENTS

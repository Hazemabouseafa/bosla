# ============================================
# BOSLA ACADEMY — ENVIRONMENT CONFIGURATION
# Copy to .env for local development or configure in Coolify
# NEVER commit real production secrets to version control
# ============================================

NODE_ENV=development
APP_NAME="BOSLA Academy"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
INTERNAL_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://bosla:bosla_dev_password@localhost:5432/bosla_academy?schema=public

# Redis (BullMQ + Rate limiting + Playback tokens)
REDIS_URL=redis://localhost:6379

# Session & Security Secrets (generate strong 64-char random hex secrets in production)
SESSION_SECRET=dev_only_replace_with_64_char_random_secret_for_production_use
RECOVERY_CODE_PEPPER=dev_only_replace_with_64_char_random_pepper_for_recovery_codes
PLAYBACK_TOKEN_SECRET=dev_only_replace_with_64_char_random_secret_for_hls_playback
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# WebAuthn / Passkeys (FIDO2)
WEBAUTHN_RP_NAME="BOSLA Academy | أكاديمية بوصلة"
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Google Identity Services (OIDC)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Enable deterministic local test token verification ONLY when NODE_ENV=test
ALLOW_TEST_GOOGLE_TOKENS=false

# Paymob API (Egypt) — Sandbox mode until production keys are configured
PAYMOB_MODE=sandbox
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com

# Self-Hosted VPS Media Storage (PRIVATE — never inside Next.js public/)
MEDIA_ROOT=/var/bosla/media
MEDIA_UPLOAD_TMP_DIR=/var/bosla/media/uploads-tmp
MEDIA_SOURCES_DIR=/var/bosla/media/sources
MEDIA_HLS_DIR=/var/bosla/media/hls
MEDIA_ATTACHMENTS_DIR=/var/bosla/media/attachments
MEDIA_THUMBNAILS_DIR=/var/bosla/media/thumbnails

# Video Upload & Transcoding Policy
MAX_VIDEO_UPLOAD_BYTES=2147483648
INSTRUCTOR_STORAGE_QUOTA_BYTES=21474836480
VIDEO_UPLOAD_SESSION_TTL_HOURS=24
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_THREADS=1
WORKER_CONCURRENCY=1
ALLOWED_VIDEO_QUALITIES=480p,720p,1080p
DISK_ALERT_THRESHOLD_PERCENT=85

# Nginx Internal Video Protection
NGINX_INTERNAL_HLS_PREFIX=/_internal_hls
NGINX_INTERNAL_ATTACHMENTS_PREFIX=/_internal_attachments
PLAYBACK_TOKEN_TTL_SECONDS=120
ALLOWED_STREAM_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STRICT_STREAM_REFERER=false
ASR_WHISPER_CLI_PATH=
